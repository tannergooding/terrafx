  <Import Project="..\..\tools\TerraFX.ShaderCompiler\ShaderCompilation.targets" />

  <Target Name="CompileRuntimeShadersBeforeResources"
          BeforeTargets="CreateManifestResourceNames"
          DependsOnTargets="TerraFXCompileShaders"
          Condition="'$(OS)' == 'Windows_NT'" />

</Project>
