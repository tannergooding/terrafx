    <EmbeddedResource Include="Shaders\Cooked\MeshC0TexturedMaskPixel.pixel.spv"
                      LogicalName="TerraFX.Rendering.Shaders.MeshC0TexturedMaskPixel.pixel.spv" />
    <EmbeddedResource Include="Shaders\Cooked\MeshC0ShadowVertex.vertex.spv"
