<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TerraFX</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraFX.Content.Tools" Key="$(AssemblyOriginatorPublicKey)" />
    <ProjectReference Include="..\TerraFX.Assets\TerraFX.Assets.csproj" />
    <ProjectReference Include="..\TerraFX.Core\TerraFX.Core.csproj" />
    <ProjectReference Include="..\TerraFX.Input\TerraFX.Input.csproj" />
    <ProjectReference Include="..\TerraFX.Platform\TerraFX.Platform.csproj" />
    <ProjectReference Include="..\TerraFX.Graphics\TerraFX.Graphics.csproj" />
    <ProjectReference Include="..\TerraFX.Physics\TerraFX.Physics.csproj" />
    <ProjectReference Include="..\TerraFX.Audio\TerraFX.Audio.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <TerraFXShaderSource Include="Shaders\SpriteC0Vertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\SpriteC0Pixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
    <TerraFXShaderSource Include="Shaders\SpriteToneMapPixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
    <TerraFXShaderSource Include="Shaders\MeshC0Vertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0TexturedVertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0SkinnedVertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0SkinnedTexturedVertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0Pixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
    <TerraFXShaderSource Include="Shaders\MeshC0MaskPixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
    <TerraFXShaderSource Include="Shaders\MeshC0TexturedPixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
    <TerraFXShaderSource Include="Shaders\MeshC0TexturedMaskPixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
    <TerraFXShaderSource Include="Shaders\MeshC0ShadowVertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0TexturedShadowVertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0SkinnedShadowVertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0SkinnedTexturedShadowVertex.hlsl" EntryPoint="VSMain" Stage="vertex" />
    <TerraFXShaderSource Include="Shaders\MeshC0ShadowPixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
    <TerraFXShaderSource Include="Shaders\MeshC0TexturedShadowPixel.hlsl" EntryPoint="PSMain" Stage="pixel" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <TerraFXShaderInclude Include="Shaders\MeshC0Vertex.hlsl" />
    <TerraFXShaderInclude Include="Shaders\MeshC0Skinning.hlsl" />
    <TerraFXShaderInclude Include="Shaders\MeshC0Pixel.hlsl" />
    <TerraFXShaderInclude Include="Shaders\MeshC0TexturedPixel.hlsl" />
    <TerraFXShaderInclude Include="Shaders\MeshC0ShadowVertex.hlsl" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <EmbeddedResource Include="Shaders\Cooked\SpriteC0Vertex.vertex.spv"
                      LogicalName="TerraFX.Rendering.Shaders.SpriteC0Vertex.vertex.spv" />
    <EmbeddedResource Include="Shaders\Cooked\SpriteC0Pixel.pixel.spv"
                      LogicalName="TerraFX.Rendering.Shaders.SpriteC0Pixel.pixel.spv" />
    <EmbeddedResource Include="Shaders\Cooked\SpriteToneMapPixel.pixel.spv"
                      LogicalName="TerraFX.Rendering.Shaders.SpriteToneMapPixel.pixel.spv" />
