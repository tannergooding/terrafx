<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PlatformTarget Condition="'$(OS)' == 'Windows_NT'">x64</PlatformTarget>
    <Microsoft_Direct3D_DXC_SkipLibraryCopy Condition="'$(OS)' == 'Windows_NT'">true</Microsoft_Direct3D_DXC_SkipLibraryCopy>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraFX.Graphics.Vulkan.Tests" Key="$(AssemblyOriginatorPublicKey)" />
    <InternalsVisibleTo Include="TerraFX.Runtime.Tests" Key="$(AssemblyOriginatorPublicKey)" />
    <ProjectReference Include="..\TerraFX.Graphics\TerraFX.Graphics.csproj" />
    <ProjectReference Include="..\TerraFX.Runtime\TerraFX.Runtime.csproj" />
    <Content Include="ShaderToolchainManifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\*.hlsl" Link="Shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.Direct3D.DXC" GeneratePathProperty="true" PrivateAssets="all" />
    <Content Include="$(PkgMicrosoft_Direct3D_DXC)\build\native\bin\x64\dxc.exe" Link="dxc.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Direct3D_DXC)\build\native\bin\x64\dxcompiler.dll" Link="dxcompiler.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Direct3D_DXC)\build\native\bin\x64\dxil.dll" Link="dxil.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Direct3D_DXC)\LICENSE-MS.txt" Link="licenses\dxc\LICENSE-MS.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Direct3D_DXC)\LICENSE-LLVM.txt" Link="licenses\dxc\LICENSE-LLVM.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Direct3D_DXC)\LICENCE-MIT.txt" Link="licenses\dxc\LICENCE-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Direct3D_DXC)\build\native\include\hlsl\LICENCE.txt" Link="licenses\dxc\hlsl-LICENCE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
