<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TerraFXProjectCategory>tools</TerraFXProjectCategory>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <SkipLocalsInit>false</SkipLocalsInit>
    <TerraFXUseRepositoryAnalyzers>false</TerraFXUseRepositoryAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerraFX.Diagnostics.Analyzers\TerraFX.Diagnostics.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CodeAnalysis\MemberOrdering.cs" Link="CodeAnalysis\MemberOrdering.cs" />
    <Compile Include="..\Shared\CodeAnalysis\StatementSpacing.cs" Link="CodeAnalysis\StatementSpacing.cs" />
    <Compile Include="..\Shared\CodeAnalysis\DocumentationCommentLayout.cs" Link="CodeAnalysis\DocumentationCommentLayout.cs" />
    <Compile Include="..\Shared\CodeAnalysis\DoesNotReturnAttribute.cs" Link="CodeAnalysis\DoesNotReturnAttribute.cs" />
    <Compile Include="..\Shared\CodeAnalysis\NotNullAttribute.cs" Link="CodeAnalysis\NotNullAttribute.cs" />
    <Compile Include="..\Shared\CodeAnalysis\ThrowHelper.cs" Link="CodeAnalysis\ThrowHelper.cs" />
    <Compile Include="..\Shared\CodeAnalysis\SyntaxEditorBasedCodeFixProvider.cs" Link="CodeAnalysis\SyntaxEditorBasedCodeFixProvider.cs" />
    <Compile Include="..\Shared\CodeAnalysis\SyntaxEditorFixAllProvider.cs" Link="CodeAnalysis\SyntaxEditorFixAllProvider.cs" />
  </ItemGroup>

</Project>
