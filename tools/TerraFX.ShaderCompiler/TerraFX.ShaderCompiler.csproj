<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PlatformTarget Condition="'$(OS)' == 'Windows_NT'">x64</PlatformTarget>
    <TerraFXProjectCategory>tools</TerraFXProjectCategory>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <SkipLocalsInit>false</SkipLocalsInit>
    <TerraFXUseRepositoryAnalyzers>false</TerraFXUseRepositoryAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraFX.Content.Tools" Key="$(AssemblyOriginatorPublicKey)" />
    <InternalsVisibleTo Include="TerraFX.Content.Tools.Tests" Key="$(AssemblyOriginatorPublicKey)" />
    <ProjectReference Include="..\..\sources\TerraFX.Graphics\TerraFX.Graphics.csproj" />
    <EmbeddedResource Include="ShaderCompilerToolchain.json"
                      LogicalName="TerraFX.Content.Tools.ShaderCompilerToolchain.json" />
  </ItemGroup>

</Project>
