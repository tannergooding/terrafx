<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>TerraFX.Runtime.ComponentConsumer</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TerraFXPublishAot)' == 'true'">
    <DocumentationFile>$(BaseOutputPath)$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/$(AssemblyName).xml</DocumentationFile>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="Microsoft.NET.Test.Sdk;NUnit;NUnit3TestAdapter" />
    <ProjectReference Include="..\..\sources\TerraFX.Assets\TerraFX.Assets.csproj" />
    <ProjectReference Include="..\..\sources\TerraFX.Graphics\TerraFX.Graphics.csproj" />
    <ProjectReference Include="..\..\sources\TerraFX.Physics\TerraFX.Physics.csproj" />
    <ProjectReference Include="..\..\sources\TerraFX.Runtime\TerraFX.Runtime.csproj" />
  </ItemGroup>

</Project>
