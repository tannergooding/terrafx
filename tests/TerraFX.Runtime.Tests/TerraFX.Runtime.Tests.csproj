<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(PublishAot)' != 'true'">
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sources\TerraFX.Content.Tools\TerraFX.Content.Tools.csproj" />
    <ProjectReference Include="..\..\sources\TerraFX.Runtime\TerraFX.Runtime.csproj" />
    <ProjectReference Include="..\..\sources\TerraFX.Graphics.D3D12\TerraFX.Graphics.D3D12.csproj" />
    <ProjectReference Include="..\..\sources\TerraFX.Graphics.Vulkan\TerraFX.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\TerraFX.Runtime.Vulkan.Consumer\TerraFX.Runtime.Vulkan.Consumer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TerraFX.Runtime.ComponentConsumer\TerraFX.Runtime.ComponentConsumer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TerraFX.Runtime.GeneratedComponentConsumer\TerraFX.Runtime.GeneratedComponentConsumer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\sources\TerraFX.Content.Tools\ShaderToolchainManifest.json" Link="ShaderToolchainManifest.json" CopyToOutputDirectory="PreserveNewest" />
    <TerraFXShaderSource Include="..\TerraFX.Content.Tools.Tests\Shaders\ObjectGpuData.hlsl" EntryPoint="VSMain" Stage="vertex" Condition="'$(OS)' == 'Windows_NT'" />
    <TerraFXShaderSource Include="Shaders\ObjectDataPipelinePixel.hlsl" EntryPoint="PSMain" Stage="pixel" Condition="'$(OS)' == 'Windows_NT'" />
    <TerraFXShaderSource Include="Shaders\SnapshotGraphVertex.hlsl" EntryPoint="VSMain" Stage="vertex" Condition="'$(OS)' == 'Windows_NT'" />
    <TerraFXShaderSource Include="Shaders\SnapshotGraphPixel.hlsl" EntryPoint="PSMain" Stage="pixel" Condition="'$(OS)' == 'Windows_NT'" />
    <TerraFXShaderSource Include="..\..\sources\TerraFX.Runtime\Shaders\SpriteC0Vertex.hlsl" EntryPoint="VSMain" Stage="vertex" Condition="'$(OS)' == 'Windows_NT'" />
    <TerraFXShaderSource Include="..\..\sources\TerraFX.Runtime\Shaders\SpriteC0Pixel.hlsl" EntryPoint="PSMain" Stage="pixel" Condition="'$(OS)' == 'Windows_NT'" />
    <TerraFXShaderSource Include="..\..\sources\TerraFX.Runtime\Shaders\SpriteToneMapPixel.hlsl" EntryPoint="PSMain" Stage="pixel" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <Import Project="..\..\tools\TerraFX.ShaderCompiler\ShaderCompilation.targets" />

  <Target Name="CopyObjectDataPipelineShaderArtifacts" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_ObjectDataPipelineOutput>$(OutDir)ShaderArtifacts\ObjectGpuDataPipeline</_ObjectDataPipelineOutput>
    </PropertyGroup>
    <MakeDir Directories="$(_ObjectDataPipelineOutput)" />
    <Copy SourceFiles="$(IntermediateOutputPath)TerraFXShaders\ObjectGpuData\ObjectGpuData.vertex.dxil;$(IntermediateOutputPath)TerraFXShaders\ObjectGpuData\ObjectGpuData.vertex.spv;$(IntermediateOutputPath)TerraFXShaders\ObjectGpuData\ObjectGpuData.dxil.reflection.txt;$(IntermediateOutputPath)TerraFXShaders\ObjectGpuData\ObjectGpuData.spirv.reflection.json;$(IntermediateOutputPath)TerraFXShaders\ObjectDataPipelinePixel\ObjectDataPipelinePixel.pixel.dxil;$(IntermediateOutputPath)TerraFXShaders\ObjectDataPipelinePixel\ObjectDataPipelinePixel.pixel.spv;$(IntermediateOutputPath)TerraFXShaders\ObjectDataPipelinePixel\ObjectDataPipelinePixel.dxil.reflection.txt;$(IntermediateOutputPath)TerraFXShaders\ObjectDataPipelinePixel\ObjectDataPipelinePixel.spirv.reflection.json;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphVertex\SnapshotGraphVertex.vertex.dxil;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphVertex\SnapshotGraphVertex.vertex.spv;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphVertex\SnapshotGraphVertex.dxil.reflection.txt;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphVertex\SnapshotGraphVertex.spirv.reflection.json;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphPixel\SnapshotGraphPixel.pixel.dxil;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphPixel\SnapshotGraphPixel.pixel.spv;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphPixel\SnapshotGraphPixel.dxil.reflection.txt;$(IntermediateOutputPath)TerraFXShaders\SnapshotGraphPixel\SnapshotGraphPixel.spirv.reflection.json;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Vertex\SpriteC0Vertex.vertex.dxil;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Vertex\SpriteC0Vertex.vertex.spv;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Vertex\SpriteC0Vertex.dxil.reflection.txt;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Vertex\SpriteC0Vertex.spirv.reflection.json;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Pixel\SpriteC0Pixel.pixel.dxil;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Pixel\SpriteC0Pixel.pixel.spv;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Pixel\SpriteC0Pixel.dxil.reflection.txt;$(IntermediateOutputPath)TerraFXShaders\SpriteC0Pixel\SpriteC0Pixel.spirv.reflection.json;$(IntermediateOutputPath)TerraFXShaders\SpriteToneMapPixel\SpriteToneMapPixel.pixel.dxil;$(IntermediateOutputPath)TerraFXShaders\SpriteToneMapPixel\SpriteToneMapPixel.pixel.spv;$(IntermediateOutputPath)TerraFXShaders\SpriteToneMapPixel\SpriteToneMapPixel.dxil.reflection.txt;$(IntermediateOutputPath)TerraFXShaders\SpriteToneMapPixel\SpriteToneMapPixel.spirv.reflection.json"
          DestinationFolder="$(_ObjectDataPipelineOutput)" />
  </Target>

</Project>
