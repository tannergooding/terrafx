<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Directory.Packages.props is automatically picked up and imported by
    NuGet.props. This file needs to exist, even if empty so that files in the
    parent directory tree, with the same name, are not imported instead.
    It is imported after Directory.Build.props.
  -->

  <!-- Package versions for package references across all projects -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.NUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.NUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageVersion Include="TerraFX.Interop.Windows" Version="10.0.26100.6" />
    <PackageVersion Include="TerraFX.Interop.Vulkan" Version="1.4.328.1" />
  </ItemGroup>

</Project>
